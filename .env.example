# Configuración opcional de ALVEA (copia a .env si deseas usar variables de entorno)
# Nunca subas tu archivo .env real a GitHub.

ALVEA_HOST=127.0.0.1
ALVEA_PORT=8000

# Proveedores Locales (sin API Key en la nube)
ALVEA_OLLAMA_URL=http://127.0.0.1:11434
ALVEA_LMSTUDIO_URL=http://127.0.0.1:1234/v1

# Proveedores Cloud con Capa Gratuita (opcionales — también configurables en la UI en memoria)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GITHUB_TOKEN=

# Proveedores BYOK opcionales
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_API_KEY=
